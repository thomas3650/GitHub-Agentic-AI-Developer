{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "labels": [
    "dependencies"
  ],
  "nuget": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "nuget"
      ],
      "groupName": "project dependencies"
    }
  ]
}
